# Template for .env - copy this to .env and fill in real values.
#   cp .env.example .env
#
# .env is gitignored; this file is committed so the required variables are documented.

# Which LLM runs stage 2, the query-parsing chain (scripts/query_parse.py).
# anthropic | gemini  (default: anthropic). A --provider flag overrides it per run.
# Without a key the chain still runs with --offline, which exercises the plumbing
# using a keyword stub but proves nothing about extraction quality.
# LLM_PROVIDER=gemini

# --- Anthropic ---------------------------------------------------------------------
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: effort level for the query-parsing gates.
# low | medium | high | xhigh | max  (default: high)
# ANTHROPIC_EFFORT=high

# --- Google Gemini (free tier) -----------------------------------------------------
# Get a key at https://aistudio.google.com/apikey
# Free-tier requests may be used by Google to improve its products.
GEMINI_API_KEY=AIza...

# Optional: model (default gemini-3.8-flash). Free-tier quotas are per model, so
# switching model is how to keep going once one model's daily quota is used up.
# GEMINI_MODEL=gemini-3.8-flash

# Optional: thinking level. minimal | low | medium | high  (default: the model's own)
# GEMINI_THINKING=high
