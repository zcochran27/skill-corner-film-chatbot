# Template for .env - copy this to .env and fill in real values.
#   cp .env.example .env
#
# .env is gitignored; this file is committed so the required variables are documented.

# Required for stage 2, the query-parsing chain (scripts/query_parse.py).
# Without it the chain still runs with --offline, which exercises the plumbing
# using a keyword stub but proves nothing about extraction quality.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional: effort level for the query-parsing gates.
# low | medium | high | xhigh | max  (default: high)
# ANTHROPIC_EFFORT=high
